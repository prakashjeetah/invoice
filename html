<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Invoice & Stock Management Suite</title>
    <style>
        :root { --primary: #2563eb; --success: #16a34a; --danger: #dc2626; --dark: #1e293b; --light: #f8fafc; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background: #e2e8f0; color: var(--dark); padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); position: relative; }
        .header { display: flex; justify-content: space-between; border-bottom: 2px solid #edf2f7; padding-bottom: 20px; margin-bottom: 20px; }
        .meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 30px; }
        input, select, textarea { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; margin-top: 4px; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; }
        th { background: var(--light); }
        .sn-col { width: 50px; } .qty-col { width: 80px; } .price-col { width: 120px; } .vat-col { width: 80px; }
        .btn { background: var(--primary); color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; text-decoration: none; display: inline-block; text-align: center; }
        .btn-success { background: var(--success); } .btn-danger { background: var(--danger); }
        .admin-section { background: #f1f5f9; padding: 20px; border-radius: 6px; margin-top: 30px; border-left: 4px solid var(--primary); }
        .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-top: 50px; padding-top: 20px; }
        .sig-box { border-top: 1px dashed var(--dark); text-align: center; padding-top: 8px; margin-top: 40px; }
        .low-stock { background: #fee2e2; color: var(--danger); font-weight: bold; }
        .hidden { display: none; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-weight: bold; color: white; font-size: 0.85em; text-align: center; margin-top: 4px; width: fit-content; }
        .bg-pending { background: #eab308; } .bg-paid { background: #16a34a; } .bg-overdue { background: #dc2626; }
        .company-config { background: #fafafa; border: 1px solid #e2e8f0; padding: 15px; border-radius: 6px; margin-bottom: 20px; }
        @media print { body { background: white; padding: 0; } .no-print { display: none !important; } .container { box-shadow: none; padding: 0; } }
    </style>
</head>
<body>

<div class="container">
    <!-- Top Bar Controls -->
    <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: #f8fafc; padding: 10px; border-radius: 6px;">
        <div>
            <span style="font-weight: bold; color: var(--success);">● Online Connected</span>
            <span style="margin-left: 15px; color: #64748b; font-size: 0.9em;">Session Auto-Backup Enabled</span>
        </div>
        <button class="btn" onclick="toggleAdmin()">Toggle Admin Dashboard</button>
    </div>

    <!-- Live Preview Header Details -->
    <div class="header">
        <div>
            <h1 id="viewCompName">Your Company Name Ltd</h1>
            <p id="viewCompAddr">123 Business Road, Mauritius</p>
            <p id="viewCompContact">BRN: C123456789 | VAT No: 27999999</p>
        </div>
        <div style="text-align: right;">
            <h2>TAX INVOICE</h2>
            <input type="text" id="invNo" value="INV-2026-001" style="width: 150px; text-align: right; font-weight: bold;">
        </div>
    </div>

    <!-- Client / Transaction Metadata -->
    <div class="meta-grid">
        <div>
            <h3>Customer Details</h3>
            <input type="text" id="custName" placeholder="Client Name">
            <textarea id="custAddr" placeholder="Client Address" rows="2"></textarea>
            <input type="text" id="custPhone" placeholder="Telephone Number">
        </div>
        <div>
            <h3>Transaction Details</h3>
            <label>Salesperson Name</label>
            <input type="text" id="salesperson" placeholder="Salesperson Name" oninput="calculateTotals()">
            
            <label>Payment Method</label>
            <select id="payMethod">
                <option value="Cash">Cash</option>
                <option value="Juice">Juice</option>
                <option value="Cheque">Cheque</option>
                <option value="Credit Cim">Credit Cim</option>
                <option value="Rogers">Rogers</option>
            </select>
            
            <label>Payment Status</label>
            <select id="payStatus" onchange="updateStatusBadge()">
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
                <option value="Overdue">Overdue</option>
            </select>
            <div id="statusBadge" class="badge bg-pending">Pending</div>
        </div>
    </div>

    <!-- Billing Table Grid -->
    <h3>Itemized Breakdown</h3>
    <table id="invoiceTable">
        <thead>
            <tr>
                <th class="sn-col">S.N.</th>
                <th>Description</th>
                <th class="qty-col">Qty</th>
                <th class="price-col">Unit Price</th>
                <th class="vat-col">VAT</th>
                <th class="price-col">Total Price</th>
                <th class="no-print" style="width: 50px;">Action</th>
            </tr>
        </thead>
        <tbody id="invoiceBody"></tbody>
    </table>
    <button class="btn no-print" onclick="addInvoiceRow()">+ Add Item</button>

    <!-- Adjustment Calculations Summary -->
    <div style="margin-left: auto; max-width: 450px; margin-top: 20px; font-size: 1.1em;">
        <div style="display: flex; justify-content: space-between; padding: 4px 0;">
            <span>Subtotal (Excl. VAT):</span><span id="txtSubtotal">Rs 0.00</span>
        </div>
        <div style="display: flex; justify-content: space-between; padding: 4px 0; align-items: center;" class="no-print">
            <span>Discount (%):</span>
            <input type="number" id="discountInput" value="0" min="0" max="100" style="width: 80px; text-align: right;" onchange="calculateTotals()">
        </div>
        <div style="display: flex; justify-content: space-between; padding: 4px 0;">
            <span>Discount Applied:</span><span id="txtDiscount">Rs 0.00</span>
        </div>
        <div style="display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.9em; color: #475569; border-top: 1px dashed #cbd5e1;">
            <span>Mauritius VAT Summary (15% Standard):</span><span id="txtVat">Rs 0.00</span>
        </div>
        <div style="display: flex; justify-content: space-between; padding: 8px 0; border-top: 2px solid var(--dark); font-weight: bold; font-size: 1.2em;">
            <span>Grand Total:</span><span id="txtGrandTotal">Rs 0.00</span>
        </div>
    </div>

    <!-- System Footers -->
    <div style="margin-top: 40px; border-top: 1px solid #cbd5e1; padding-top: 10px;">
        <h4>Terms & Conditions / Footer Notes</h4>
        <textarea id="footerNotes" rows="2" placeholder="Thank you for your business. Payment via Juice/Bank transfer should quote the Invoice ID. Goods remain property of seller until fully paid."></textarea>
    </div>

    <!-- Validation Signature Interfaces -->
    <div class="signatures">
        <div class="sig-box">Received By (Sales Authorized Signature)</div>
        <div class="sig-box">Client Signature (Goods Received in Good Order)</div>
    </div>

    <!-- Print & Download Control Blocks -->
    <div class="no-print" style="margin-top: 30px; display: flex; gap: 10px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
        <button class="btn btn-success" onclick="window.print()">Print / Export PDF Acknowledgment</button>
        <button class="btn" onclick="exportInvoiceCSV()">Download Invoice CSV</button>
    </div>

    <!-- Password Protected Administrative Portal Interface Layout -->
    <div id="adminPanel" class="admin-section hidden no-print">
        <h2>🔒 Administrative Control Dashboard</h2>
        <div id="adminAuth">
            <p style="margin-bottom: 10px;">Enter security password to view margins, inventory valuation, and commission records:</p>
            <input type="password" id="adminPass" style="max-width: 250px; margin-right: 10px;" placeholder="Password">
            <button class="btn" onclick="authAdmin()">Unlock Data</button>
        </div>
        
        <div id="adminContent" class="hidden">
            <!-- Global Profile Overrides Setup Panel -->
            <div class="company-config">
                <h3>🏢 Edit Online Profile Details</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                    <input type="text" id="cfgCompName" value="Your Company Name Ltd" placeholder="Company Name" oninput="syncBranding()">
                    <input type="text" id="cfgCompAddr" value="123 Business Road, Mauritius" placeholder="Company Address" oninput="syncBranding()">
                    <input type="text" id="cfgCompContact" value="BRN: C123456789 | VAT No: 27999999" placeholder="Tax IDs / Contact" oninput="syncBranding()">
                    <div style="display: flex; align-items: center; justify-content: space-between; border: 1px dashed #cbd5e1; padding: 5px; border-radius: 4px;">
                        <span style="font-size: 0.85em; color: #64748b;">Logo Asset Configuration:</span>
